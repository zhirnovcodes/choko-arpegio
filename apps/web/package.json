    "ivandaw-core": "github:zhirnovcodes/ivan-daw-core#v0.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.1.0"
  }
}
